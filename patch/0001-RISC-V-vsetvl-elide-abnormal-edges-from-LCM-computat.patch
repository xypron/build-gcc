+import (
+	"go/token"
+	"go/scanner"
+	"reflect"
+)
+type v struct {}
+type w func( string,  reflect.Value) bool
+func x( string,  reflect.Value) bool
+type r struct {
+	scanner.ErrorList
+}
+type ab interface {}
+type ae interface {}
+type af interface {}
+type ag struct {}
+func (ag) Pos() token.Pos
+func (ag) ah() token.Pos
+type c struct {
+	aj    ae          }
+type ak struct {
+	al    []c  }
+type (
+	am struct {
+		an    string    }
+	bs struct {
+		Value    string
+	  }
